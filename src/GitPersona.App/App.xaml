<Application x:Class="GitPersona.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:GitPersona.App.ViewModels"
             xmlns:views="clr-namespace:GitPersona.App.Views"
             xmlns:conv="clr-namespace:GitPersona.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:PresenceToVisibilityConverter x:Key="Presence" />
            <conv:PresenceToVisibilityConverter x:Key="Absence" Invert="True" />
            <conv:InverseBooleanConverter x:Key="Not" />
            <conv:EqualsToVisibilityConverter x:Key="WhenEquals" />

            <!-- Page view model -> view -->
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
                <views:ProfilesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileEditorViewModel}">
                <views:ProfileEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CloneViewModel}">
                <views:CloneView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ScannerViewModel}">
                <views:ScannerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
                <views:DiagnosticsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
