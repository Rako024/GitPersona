<UserControl x:Class="GitPersona.App.Views.ProfileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:GitPersona.App.Localization"
             xmlns:vm="clr-namespace:GitPersona.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProfileEditorViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12" Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="20" Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                <ui:SymbolIcon FontSize="20" Foreground="White" Symbol="{Binding Icon}" />
            </Border>
            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{Binding Heading}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Identity -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource CardTitleStyle}" Text="{l:Loc Editor_Identity}" />

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{l:Loc Field_DisplayName}" />
                            <ui:TextBox AutomationProperties.Name="{l:Loc Field_DisplayName}" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="İş / Work" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{l:Loc Field_Id}" />
                            <ui:TextBox AutomationProperties.Name="{l:Loc Field_Id}" FontFamily="Cascadia Mono, Consolas" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="work" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Field_Id_Help}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{l:Loc Field_GitUserName}" />
                            <ui:TextBox AutomationProperties.Name="{l:Loc Field_GitUserName}" Text="{Binding GitUserName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{l:Loc Field_GitUserEmail}" />
                            <ui:TextBox AutomationProperties.Name="{l:Loc Field_GitUserEmail}" Text="{Binding GitUserEmail, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="you@example.com" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{l:Loc Field_GitHubUsername}" />
                            <ui:TextBox AutomationProperties.Name="{l:Loc Field_GitHubUsername}" Text="{Binding GitHubUsername, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- SSH -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="{l:Loc Editor_Ssh}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{l:Loc Field_HostAlias}" />
                                <ui:TextBox AutomationProperties.Name="{l:Loc Field_HostAlias}" FontFamily="Cascadia Mono, Consolas" Text="{Binding HostAlias, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="github-work" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Field_HostAlias_Help}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{l:Loc Field_Host}" />
                                <ui:TextBox AutomationProperties.Name="{l:Loc Field_Host}" FontFamily="Cascadia Mono, Consolas" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Field_Host_Help}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{l:Loc Field_SshKey}" />
                        <ui:TextBox AutomationProperties.Name="{l:Loc Field_SshKey}" FontFamily="Cascadia Mono, Consolas" Text="{Binding SshKeyPath, UpdateSourceTrigger=LostFocus}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryTextStyle}" FontFamily="Cascadia Mono, Consolas" Text="{Binding KeyDescription}" />
                        <WrapPanel Margin="0,10,0,0">
                            <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon KeyMultiple24}" Command="{Binding GenerateKeyCommand}" Content="{l:Loc Key_Generate}" />
                            <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding ChooseKeyCommand}" Content="{l:Loc Key_Choose}" />
                            <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyPublicKeyCommand}" Content="{l:Loc Key_CopyPublic}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="13" Text="{Binding KeyMessage}"
                                   Visibility="{Binding KeyMessage, Converter={StaticResource Presence}}" />
                    </StackPanel>
                </Border>

                <!-- Rules -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="{l:Loc Editor_Rules}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{l:Loc Field_Folders}" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Field_Folders_Help}" />
                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4" Padding="10,4,4,4" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <DockPanel>
                                            <ui:Button DockPanel.Dock="Right"
                                                       Padding="6"
                                                       Appearance="Transparent"
                                                       Icon="{ui:SymbolIcon Dismiss16}"
                                                       ToolTip="{l:Loc Common_Remove}"
                                                       AutomationProperties.Name="{l:Loc Common_Remove}"
                                                       Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                            <TextBlock VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" Text="{Binding}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button Margin="0,4,0,16" Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding AddFolderCommand}" Content="{l:Loc Folders_Add}" />

                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{l:Loc Field_Owners}" />
                        <TextBlock Margin="0,0,0,6" Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Field_Owners_Help}" />
                        <ItemsControl ItemsSource="{Binding Owners}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,6" Padding="10,2,2,2" CornerRadius="12" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                            <ui:Button Margin="2,0,0,0"
                                                       Padding="4"
                                                       Appearance="Transparent"
                                                       Icon="{ui:SymbolIcon Dismiss16}"
                                                       ToolTip="{l:Loc Common_Remove}"
                                                       AutomationProperties.Name="{l:Loc Common_Remove}"
                                                       Command="{Binding DataContext.RemoveOwnerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,2,0,0">
                            <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding AddOwnerCommand}" Content="{l:Loc Owners_Add}" />
                            <ui:TextBox AutomationProperties.Name="{l:Loc Owners_Placeholder}" Text="{Binding NewOwner, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{l:Loc Owners_Placeholder}">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddOwnerCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                        </DockPanel>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource ErrorTextStyle}" Text="{Binding OwnerMessage}"
                                   Visibility="{Binding OwnerMessage, Converter={StaticResource Presence}}" />

                        <TextBlock Margin="0,16,0,4" Style="{StaticResource FieldLabelStyle}" Text="{l:Loc Field_CloneFolder}" />
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding BrowseCloneFolderCommand}" Content="{l:Loc Common_Browse}" />
                            <ui:TextBox AutomationProperties.Name="{l:Loc Field_CloneFolder}" FontFamily="Cascadia Mono, Consolas" Text="{Binding DefaultCloneFolder, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Field_CloneFolder_Help}" />
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}" Text="{l:Loc Editor_Appearance}" />
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{l:Loc Field_Color}" />
                        <ListBox Style="{StaticResource SwatchListStyle}"
                                 ItemContainerStyle="{StaticResource SwatchItemStyle}"
                                 ItemsSource="{x:Static vm:ProfileEditorViewModel.ColorPalette}"
                                 SelectedItem="{Binding Color}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="24" Height="24" Fill="{Binding Converter={StaticResource HexToBrush}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="0,8,0,4" Style="{StaticResource FieldLabelStyle}" Text="{l:Loc Field_Icon}" />
                        <ListBox Style="{StaticResource SwatchListStyle}"
                                 ItemContainerStyle="{StaticResource SwatchItemStyle}"
                                 ItemsSource="{x:Static vm:ProfileEditorViewModel.IconPalette}"
                                 SelectedItem="{Binding Icon}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <ui:SymbolIcon FontSize="20" Symbol="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Errors and actions -->
        <StackPanel Grid.Row="2" Margin="0,8,0,16">
            <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding Errors}" Visibility="{Binding Errors.Count, Converter={StaticResource Presence}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,6,0" FontSize="16" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="ErrorCircle24" />
                            <TextBlock Style="{StaticResource ErrorTextStyle}" Text="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel LastChildFill="False">
                <ui:Button DockPanel.Dock="Left" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" Content="{l:Loc Common_Save}" />
                <ui:Button DockPanel.Dock="Left" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding RevertCommand}" Content="{l:Loc Editor_Revert}" />
                <ui:Button DockPanel.Dock="Right" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteCommand}" Content="{l:Loc Editor_Delete}"
                           Visibility="{Binding IsNew, Converter={StaticResource Absence}}" />
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
