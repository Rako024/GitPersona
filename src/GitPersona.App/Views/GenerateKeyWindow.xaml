<ui:FluentWindow x:Class="GitPersona.App.Views.GenerateKeyWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:GitPersona.App.Localization"
                 xmlns:vm="clr-namespace:GitPersona.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:GenerateKeyViewModel}"
                 Title="{l:Loc KeyGen_Title}"
                 Width="560"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <StackPanel>
        <ui:TitleBar Title="{l:Loc KeyGen_Title}" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="24,8,24,0" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
            <TextBlock Margin="0,0,0,16" Style="{StaticResource SecondaryTextStyle}" FontSize="13" Text="{l:Loc KeyGen_Intro}" />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{l:Loc KeyGen_Path}" />
            <ui:TextBox AutomationProperties.Name="{l:Loc KeyGen_Path}" FontFamily="Cascadia Mono, Consolas" Text="{Binding KeyPath, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,12,0,4" Style="{StaticResource FieldLabelStyle}" Text="{l:Loc KeyGen_Comment}" />
            <ui:TextBox AutomationProperties.Name="{l:Loc KeyGen_Comment}" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="0,12,0,4" Style="{StaticResource FieldLabelStyle}" Text="{l:Loc KeyGen_Passphrase}" />
            <ui:PasswordBox x:Name="Passphrase" AutomationProperties.Name="{l:Loc KeyGen_Passphrase}" />
            <TextBlock Margin="0,12,0,4" Style="{StaticResource FieldLabelStyle}" Text="{l:Loc KeyGen_Confirm}" />
            <ui:PasswordBox x:Name="Confirmation" AutomationProperties.Name="{l:Loc KeyGen_Confirm}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc KeyGen_PassphraseNote}" />

            <TextBlock Margin="0,12,0,0" Style="{StaticResource ErrorTextStyle}" Text="{Binding ErrorMessage}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource Presence}}" />
        </StackPanel>

        <DockPanel Margin="24,20,24,20" LastChildFill="False">
            <ui:ProgressRing DockPanel.Dock="Left" Width="24" Height="24" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource Presence}}" />
            <ui:Button DockPanel.Dock="Right" MinWidth="96" Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon KeyMultiple24}"
                       IsDefault="True" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                       Click="OnGenerateClick" Content="{l:Loc KeyGen_Generate}" />
            <ui:Button DockPanel.Dock="Right" MinWidth="96" IsCancel="True" Content="{l:Loc Common_Cancel}" />
        </DockPanel>
    </StackPanel>
</ui:FluentWindow>
