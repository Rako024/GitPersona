<UserControl x:Class="GitPersona.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:GitPersona.App.Localization"
             xmlns:vm="clr-namespace:GitPersona.App.ViewModels"
             xmlns:diag="clr-namespace:GitPersona.Core.Diagnostics;assembly=GitPersona.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DiagnosticsViewModel}">
    <UserControl.Resources>
        <!-- Icon and colour per severity, shared by the profile tests and the checks. -->
        <Style x:Key="SeverityIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,1,10,0" />
            <Setter Property="Symbol" Value="Circle24" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:DiagnosticSeverity.Ok}">
                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:DiagnosticSeverity.Info}">
                    <Setter Property="Symbol" Value="Info24" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:DiagnosticSeverity.Warning}">
                    <Setter Property="Symbol" Value="Warning24" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static diag:DiagnosticSeverity.Error}">
                    <Setter Property="Symbol" Value="ErrorCircle24" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="920" Margin="0,0,12,32" HorizontalAlignment="Left">
            <TextBlock Margin="0,0,0,16" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Loc Diagnostics_Description}" />
            <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" FontSize="13" Text="{Binding StatusMessage}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource Presence}}" />

            <!-- SSH per profile -->
            <DockPanel Margin="0,0,0,8">
                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding TestAllCommand}" Content="{l:Loc Diag_TestAll}"
                           Visibility="{Binding HasProfiles, Converter={StaticResource Presence}}" />
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="{l:Loc Diag_Profiles}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Diag_ProfilesHint}" />
                </StackPanel>
            </DockPanel>
            <TextBlock Margin="0,0,0,12" Style="{StaticResource SecondaryTextStyle}" FontSize="13" Text="{l:Loc Diag_NoProfiles}"
                       Visibility="{Binding HasProfiles, Converter={StaticResource Absence}}" />
            <ItemsControl ItemsSource="{Binding ProfileTests}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProfileTestViewModel}">
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,6" Padding="16,12">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top" Icon="{ui:SymbolIcon PlugConnected24}"
                                           Command="{Binding TestCommand}" Content="{l:Loc Diag_Test}" AutomationProperties.Name="{Binding Name, StringFormat='Test {0}'}" />
                                <Border DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Top" CornerRadius="14"
                                        Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                                    <ui:SymbolIcon FontSize="14" Foreground="White" Symbol="{Binding Icon}" />
                                </Border>
                                <StackPanel>
                                    <TextBlock>
                                        <Run FontSize="14" FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                                        <Run FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Alias, Mode=OneWay, StringFormat='  {0}'}" />
                                    </TextBlock>
                                    <DockPanel Margin="0,4,0,0">
                                        <ui:SymbolIcon DockPanel.Dock="Left" Style="{StaticResource SeverityIcon}" FontSize="16" />
                                        <TextBlock TextWrapping="Wrap" FontSize="13" Text="{Binding StatusText}" />
                                    </DockPanel>
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource MonospaceTextStyle}" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Output}"
                                               Visibility="{Binding Output, Converter={StaticResource Presence}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Windows checks -->
            <DockPanel Margin="0,20,0,8">
                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RunChecksCommand}" Content="{l:Loc Diag_RunChecks}" />
                <ui:ProgressRing DockPanel.Dock="Right" Width="18" Height="18" Margin="0,0,12,0" IsIndeterminate="True"
                                 Visibility="{Binding IsChecking, Converter={StaticResource Presence}}" />
                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{l:Loc Diag_Checks}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Checks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DiagnosticItemViewModel}">
                        <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,6" Padding="16,12">
                            <DockPanel>
                                <ui:Button x:Name="ActionButton" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top"
                                           Command="{Binding ActionCommand}" Content="{Binding ActionLabel}"
                                           Visibility="{Binding ActionLabel, Converter={StaticResource Presence}}" />
                                <ui:SymbolIcon DockPanel.Dock="Left" Style="{StaticResource SeverityIcon}" />
                                <StackPanel>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Text}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                                <Setter TargetName="ActionButton" Property="Appearance" Value="Danger" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
