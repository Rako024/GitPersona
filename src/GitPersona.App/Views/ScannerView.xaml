<UserControl x:Class="GitPersona.App.Views.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:GitPersona.App.Localization"
             xmlns:vm="clr-namespace:GitPersona.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ScannerViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,12" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:Loc Scanner_Description}" />

        <!-- Searched folders -->
        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}">
            <StackPanel>
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon FolderAdd24}" Command="{Binding AddFolderCommand}" Content="{l:Loc Folders_Add}" />
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{l:Loc Scanner_Roots}" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{l:Loc Scanner_RootsHint}" />
                    </StackPanel>
                </DockPanel>
                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Roots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScanRoot}">
                            <Border Margin="0,0,6,6" Padding="10,3,3,3" CornerRadius="12" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon FontSize="14" Symbol="Folder24" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" Text="{Binding Path}" />
                                    <TextBlock Margin="6,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Label}" />
                                    <ui:Button Padding="4" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss16}"
                                               ToolTip="{l:Loc Common_Remove}" AutomationProperties.Name="{l:Loc Common_Remove}"
                                               Visibility="{Binding IsExtra, Converter={StaticResource Presence}}"
                                               Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="13" Text="{l:Loc Scanner_NoRoots}"
                           Visibility="{Binding HasRoots, Converter={StaticResource Absence}}" />
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="False">
            <ui:Button DockPanel.Dock="Left" Appearance="Primary" Icon="{ui:SymbolIcon FolderSearch24}" Command="{Binding ScanCommand}" Content="{l:Loc Scanner_Scan}" />
            <ui:Button DockPanel.Dock="Left" Margin="8,0,0,0" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopCommand}" Content="{l:Loc Clone_Stop}"
                       Visibility="{Binding IsBusy, Converter={StaticResource Presence}}" />
            <ui:Button DockPanel.Dock="Left" Margin="8,0,0,0" Icon="{ui:SymbolIcon Wrench24}" Command="{Binding FixAllCommand}" Content="{l:Loc Scanner_FixAll}" />
            <CheckBox DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center" IsChecked="{Binding OnlyProblems}" Content="{l:Loc Scanner_OnlyProblems}" />
            <ui:ProgressRing DockPanel.Dock="Left" Width="18" Height="18" Margin="16,0,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource Presence}}" />
            <TextBlock DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" FontSize="13" Text="{Binding Summary}" />
        </DockPanel>

        <!-- Results -->
        <ScrollViewer Grid.Row="3" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" FontSize="13" Text="{Binding StatusMessage}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource Presence}}" />
                <ItemsControl ItemsSource="{Binding ReportsView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RepoReportViewModel}">
                            <Border x:Name="Card" Style="{StaticResource SectionCardStyle}" Margin="0,0,0,8" Padding="16,12">
                                <StackPanel>
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Padding="6" Appearance="Transparent" Icon="{ui:SymbolIcon FolderOpen24}"
                                                   ToolTip="{l:Loc Clone_OpenFolder}" AutomationProperties.Name="{l:Loc Clone_OpenFolder}"
                                                   Command="{Binding DataContext.OpenRepositoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}" />
                                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top"
                                                Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                                            <ui:SymbolIcon FontSize="14" Foreground="White" Symbol="{Binding Icon}" />
                                        </Border>
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock>
                                                <Run FontSize="15" FontWeight="SemiBold" Text="{Binding Name, Mode=OneWay}" />
                                                <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ProfileName, Mode=OneWay, StringFormat='  ·  {0}'}" />
                                                <Run Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding SourceText, Mode=OneWay, StringFormat=' ({0})'}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontFamily="Cascadia Mono, Consolas" Text="{Binding Path}" />
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontFamily="Cascadia Mono, Consolas" Text="{Binding RemoteUrl}" />
                                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding EmailText}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <ItemsControl Margin="38,6,0,0" ItemsSource="{Binding Issues}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:RepoIssueViewModel}">
                                                <DockPanel Margin="0,4,0,0">
                                                    <ui:Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top" Icon="{ui:SymbolIcon Wrench24}"
                                                               Command="{Binding FixCommand}" Content="{l:Loc Scanner_Fix}"
                                                               Visibility="{Binding HasFix, Converter={StaticResource Presence}}" />
                                                    <ui:SymbolIcon x:Name="IssueIcon" DockPanel.Dock="Left" Margin="0,1,8,0" VerticalAlignment="Top" FontSize="16"
                                                                   Symbol="Info24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock x:Name="IssueText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Text}" />
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                        <Setter TargetName="IssueIcon" Property="Symbol" Value="ErrorCircle24" />
                                                        <Setter TargetName="IssueIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        <Setter TargetName="IssueText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasProblems}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
