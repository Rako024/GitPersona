<ui:FluentWindow x:Class="GitPersona.App.Views.DiffPreviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:GitPersona.App.Localization"
                 xmlns:vm="clr-namespace:GitPersona.App.ViewModels"
                 xmlns:cf="clr-namespace:GitPersona.Core.ConfigFiles;assembly=GitPersona.Core"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:DiffPreviewViewModel}"
                 Title="{l:Loc Review_Title}"
                 Width="940"
                 Height="720"
                 MinWidth="640"
                 MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{l:Loc Review_Title}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="24,8,24,12">
            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="13" Text="{l:Loc Review_Intro}" />
            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PlanIssueViewModel}">
                        <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <DockPanel>
                                <ui:SymbolIcon x:Name="Icon" DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Top" FontSize="18"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" Symbol="Warning24" />
                                <TextBlock TextWrapping="Wrap" FontSize="13" Text="{Binding Text}" />
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsBlocking}" Value="True">
                                <Setter TargetName="Icon" Property="Symbol" Value="ErrorCircle24" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="24,0,12,0" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Files}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FileDiffViewModel}">
                        <Border Style="{StaticResource SectionCardStyle}" Padding="0">
                            <StackPanel>
                                <DockPanel Margin="16,12">
                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource MonospaceTextStyle}" Text="{Binding Stats}" />
                                    <StackPanel>
                                        <TextBlock FontSize="14" FontWeight="SemiBold">
                                            <Run Text="{Binding Title, Mode=OneWay}" />
                                            <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Normal" Text="{Binding KindLabel, Mode=OneWay, StringFormat='({0})'}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource SecondaryTextStyle}" FontFamily="Cascadia Mono, Consolas" Text="{Binding Path}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Padding="0,6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DiffLineViewModel}">
                                                <Border x:Name="Row" Padding="16,1" Background="Transparent">
                                                    <TextBlock x:Name="Text" Style="{StaticResource MonospaceTextStyle}" TextWrapping="Wrap" Text="{Binding Text}" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static cf:DiffLineKind.Added}">
                                                        <Setter TargetName="Row" Property="Background" Value="#3010B981" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static cf:DiffLineKind.Removed}">
                                                        <Setter TargetName="Row" Property="Background" Value="#30EF4444" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static cf:DiffLineKind.Skipped}">
                                                        <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        <Setter TargetName="Text" Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="24,14" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button MinWidth="96" Command="{Binding CancelCommand}" Content="{l:Loc Common_Cancel}" IsCancel="True" />
                    <ui:Button MinWidth="96" Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"
                               Command="{Binding ApplyCommand}" Content="{l:Loc Review_Apply}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource ErrorTextStyle}" Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource Presence}}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="13" Text="{Binding Footer}"
                               Visibility="{Binding Footer, Converter={StaticResource Presence}}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
